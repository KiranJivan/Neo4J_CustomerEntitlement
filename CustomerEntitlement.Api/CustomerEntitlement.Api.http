@CustomerEntitlement.Api_HostAddress = http://localhost:5258

# ---------------------------------------------------------------------------
# ALLOW — Kiran: ServiceRequest on SRV-STOP via CH-CALL
# Expected: isAllowed=true, grantedTerm="CallCenterServicing"
# ---------------------------------------------------------------------------
POST {{CustomerEntitlement.Api_HostAddress}}/api/entitlements/evaluate
Content-Type: application/json

{
  "subjectId":  "P-001",
  "action":     "ServiceRequest",
  "resourceId": "SRV-STOP",
  "channelId":  "CH-CALL"
}

###

